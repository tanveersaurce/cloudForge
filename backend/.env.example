NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://cloudforge:cloudforge_dev_password@localhost:5432/cloudforge?schema=public"
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Authentication & Session Security (generate strong 32+ char secrets before running)
JWT_ACCESS_SECRET=replace-with-a-secure-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
